# Servidor
PORT=3000
NODE_ENV=development

# JWT — cambiar JWT_SECRET por un valor seguro en producción
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=8h

# LDAP / Active Directory
LDAP_URL=ldap://ldap.empresa.com:389
LDAP_BASE_DN=dc=empresa,dc=com
LDAP_BIND_DN=cn=readonly,dc=empresa,dc=com
LDAP_BIND_PASSWORD=

# Base de datos MySQL
# Estos valores apuntan al MySQL dockerizado (ver README: "Solo la base en Docker").
# Requiere: cp .env.example .env (en la raíz) && docker compose up -d db
# Si usas un MySQL instalado localmente en su lugar, ajusta host/puerto/usuario.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=wuolla_planner
DB_USER=root
DB_PASSWORD=secret

# Usuarios de prueba para desarrollo (solo si LDAP no responde)
# Formato: usuario:clave,usuario2:clave2
DEV_USERS=admin:admin1,demo:demo

# URL del frontend React (para CORS)
FRONTEND_URL=http://localhost:5173
