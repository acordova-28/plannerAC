# Servidor
PORT=3000
NODE_ENV=development

# JWT — cambiar JWT_SECRET por un valor seguro en producción
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=8h

# LDAP / Active Directory
LDAP_URL=ldap://ldap.empresa.com:389
LDAP_BASE_DN=dc=empresa,dc=com
LDAP_BIND_DN=cn=readonly,dc=empresa,dc=com
LDAP_BIND_PASSWORD=

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wuolla_planner
DB_USER=admin
DB_PASSWORD=admin1

# Usuarios de prueba para desarrollo (solo si LDAP no responde)
# Formato: usuario:clave,usuario2:clave2
DEV_USERS=admin:admin1,demo:demo

# URL del frontend React (para CORS)
FRONTEND_URL=http://localhost:5173
