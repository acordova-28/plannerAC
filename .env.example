# Copiar a ".env" en la raíz antes de levantar docker-compose

# "development" habilita el fallback DEV_USERS si LDAP no responde/no está configurado.
# Usar "production" en despliegues reales (requiere LDAP_* configurados).
NODE_ENV=development

# MySQL
DB_NAME=wuolla_planner
DB_PASSWORD=secret
# Puerto en el host para conectar herramientas externas (Workbench, DBeaver) al MySQL dockerizado.
# 3307 por defecto para no chocar con un MySQL local en 3306.
DB_HOST_PORT=3307

# JWT — cambiar JWT_SECRET por un valor seguro en producción
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=8h

# LDAP / Active Directory (dejar vacío para depender del fallback DEV_USERS)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Filtra qué grupos LDAP se sincronizan como planes (substring match, opcional)
LDAP_PLANS_BASE=

# Usuarios de prueba cuando LDAP no responde (formato: usuario:clave,usuario2:clave2)
DEV_USERS=admin:admin1,demo:demo
